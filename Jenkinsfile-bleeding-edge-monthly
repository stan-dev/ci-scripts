properties([
  disableConcurrentBuilds(abortPrevious: true),
  buildDiscarder(logRotator(numToKeepStr: '8', daysToKeepStr: '90')),
  parameters([
    string(defaultValue: 'develop', name: 'cmdstan_pr',
           description: "CmdStan PR to test against. Will check out this PR in the downstream Stan repo. Example: PR-123"),
    string(defaultValue: 'develop', name: 'stan_pr',
           description: "Stan PR to test against. Will check out this PR in the downstream Stan repo. Example: PR-123"),
    string(defaultValue: 'develop', name: 'math_pr',
           description: "Math PR to test against. Will check out this PR in the downstream Math repo. Example: PR-123"),
    string(defaultValue: 'master', name: 'stanc3_pr',
           description: "Stanc3 PR to test against. Will check out this PR in the downstream Math repo. Example: PR-123"),
    booleanParam(defaultValue: true, name: 'run_gcc', description: "Run GCC?"),
    booleanParam(defaultValue: true, name: 'run_clang', description: "Run clang?"),
    booleanParam(defaultValue: true, description: 'Run Full Unit Tests', name: 'run_full_unit_tests'),
    booleanParam(defaultValue: true, description: 'Run CmdStan & Math tests', name: 'run_cmdstan_math_tests'),

    string(name: 'custom_gcc_tag', description: "Example: 13.3.0 | See: https://api.github.com/repos/gcc-mirror/gcc/tags"),
    string(name: 'custom_llvm_tag', description: "Example: 19.1.0-rc4 | See: https://api.github.com/repos/llvm/llvm-project/tags")
  ])
])

class Compiler {
  String cc
  String cxx
}

def compilers = []
if (params.run_gcc)
  compilers <<= new Compiler(cc: "gcc", cxx: "g++")
if (params.run_clang)
  compilers <<= new Compiler(cc: "clang", cxx: "clang++")

def setupMakeLocal(String o, Compiler compiler, String cxxFlags = "", String makeLocalPath = "make/local") {
  def text = """
O=${o}
CC=${compiler.cc}
CXX=${compiler.cxx}
"""
  if (compiler.cc == "clang") {
    text += """
CFLAGS+=-stdlib=libc++ -isystem \$(LLVM_PREFIX)/include
CPPFLAGS+=-nostdinc++ -nodefaultlibs -isystem \$(LLVM_PREFIX)/include
CXXFLAGS+=-nostdinc++ -nostdlib++ -isystem \$(LLVM_PREFIX)/include/c++/v1 ${cxxFlags}
LDFLAGS+=-L\$(LLVM_PREFIX)/lib -Wl,-R\$(LLVM_PREFIX)/lib -lc++ -lc++abi -lm -lc -lgcc_s -lgcc
"""
  }
  writeFile(file: makeLocalPath, text: text)
  sh "${compiler.cxx} --version"
}

def jumboFlags = ' --jumbo --debug'

def runTests(String args) {
  catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
    sh('python3 runTests.py -j$PARALLEL ' + args)
  }
  // junit 'test/**/*.xml'
}

def branchRef(String branch) {
  def ref = "refs/heads/$branch"
  if (branch.startsWith("PR-"))
    ref = "pull/${pr.minus('PR-')}/head"
  return ref
}

def checkoutRepo(String repo, String branch = 'master') {
  checkout scmGit(
    userRemoteConfigs: [[url: "https://github.com/stan-dev/$repo"]],
    branches: [[name: branchRef(branch)]],
    extensions: [cloneOption(noTags: true, shallow: true, depth: 8),
      submodule(shallow: true, depth: 8, recursiveSubmodules: true)])
}

catchError {
  buildImage(context: 'docker/bleeding-edge-compilers',
    buildArgs: "--build-arg CUSTOM_GCC_TAG=$custom_gcc_tag --build-arg CUSTOM_LLVM_TAG=$custom_llvm_tag")

  withEnv([
    'STAN_NUM_THREADS=4',
    'N_TESTS=100',
    'GCC=g++',
  ]) {
    if (params.run_full_unit_tests) {
      stage('Full Unit Tests') {
        def tests =
          [ "Rev/Fwd": [
              "test/unit/math/rev",
              "test/unit/math/fwd"
            ],
            "Mix": [
              "test/unit/math/mix $jumboFlags"
            ],
            "Prim": [ 
              "test/unit/*_test.cpp",
              "test/unit/math/*_test.cpp",
              "test/unit/math/prim $jumboFlags",
              "test/unit/math/memory"
            ]
          ]
        compilers.each { compiler ->
          parallel(tests.collectEntries { test, units -> [test, {
            runPod(checkout: false, memory: (test == 'Mix' ? '80Gi' : '16Gi')) {
              stage("$test Unit Tests - ${compiler.cc}") {
                checkoutRepo('math', params.math_pr)
                setupMakeLocal("3", compiler)
                units.each { runTests(it) }
              }
            }
          } ] })
        }
      }
    }
    if (params.run_cmdstan_math_tests) {
      stage("CmdStan & Math tests") {
        compilers.each { compiler ->
          runPod(checkout: false) {
            stage("Model end-to-end - ${compiler.cc}") {
              dir('stanc3') {
                checkoutRepo('stanc3', params.stanc3_pr)
              }
              dir('bin') {
                sh '''
                  wget -O stanc https://github.com/stan-dev/stanc3/releases/download/nightly/linux-stanc
                  chmod +x stanc
                '''
              }
              dir('performance-tests-cmdstan') {
                checkoutRepo('performance-tests-cmdstan')
                checkoutPR("cmdstan", params.cmdstan_pr)
                checkoutPR("cmdstan/stan", params.stan_pr)
                checkoutPR("cmdstan/stan/lib/stan_math", params.math_pr)
                setupMakeLocal("3",compiler,"-march=core2", "cmdstan/make/local")
                sh '''
                  git show HEAD --stat
                  echo example-models/regression_tests/mother.stan > all.tests
                  cat known_good_perf_all.tests >> all.tests
                  echo >> all.tests
                  cat shotgun_perf_all.tests >> all.tests
                  cat all.tests
                '''
                dir('cmdstan') {
                  sh '''
                    make clean-all
                    git show HEAD --stat
                    make -j$PARALLEL build
                    rm bin/stanc
                    cp ../../bin/stanc bin/stanc
                    make print-compiler-flags
                    make -j$PARALLEL examples/bernoulli/bernoulli
                    bin/stanc --version
                  '''
                }
                sh '''
                  echo "STANCFLAGS += --O1" >> cmdstan/make/local
                  ./runPerformanceTests.py -j$PARALLEL --overwrite-golds --runs=0 --tests-file all.tests --num-samples=20
                  ./runPerformanceTests.py -j$PARALLEL --runs=0 ../stanc3/test/integration/good
                '''
                /* xunit([GoogleTest(
                    deleteOutputFiles: false,
                    failIfNotNew: true,
                    pattern: 'performance.xml',
                    skipNoTestFiles: false,
                    stopProcessingIfError: false)
                ]) */
                archiveArtifacts 'performance.xml'
              }
            }
          }
        }
      }
    }
  }
}

emailFailure()
